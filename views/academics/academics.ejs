<!-- views/academics/academics.ejs -->
<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head.ejs', { 
        title: 'Special Needs Education - David Ofoeyeno Special School', 
        description: 'Discover the specialized academic programs at David Ofoeyeno Special School in Warri, Delta State, designed to support children with autism and neurological disorders.' 
    }) %>

    <body>
        <%- include('../partials/nav.ejs') %>

        <div class="disco-first">
            <%- include('../partials/carousel.ejs') %>
        </div>

        <div class="aca-first">
            <h1>Special Needs Education</h1>
            <p>
                At <a href="/">David Ofoeyeno Special School</a> in Warri, Delta State, we are dedicated to guiding students with autism and neurological disorders in unlocking their personal and educational capabilities. Our tailored academic programs foster their role as valued participants in both family and community spheres. Explore our <a href="/activity">activities</a> and <a href="/about">about</a> pages to learn more.
            </p>
        </div>

        <div class="kelz-images">
            <div class="kelz-home">
                <img 
                    class="kelz-2home" 
                    src="https://storage.googleapis.com/<%= bucketName %>/direct/b39.jpg" 
                    alt="Students learning at David Ofoeyeno Special School"
                >
            </div>
            <div class="kelz-home">
                <img 
                    class="kelz-2home" 
                    src="https://storage.googleapis.com/<%= bucketName %>/direct/t2.jpg" 
                    alt="Special needs education at David Ofoeyeno Special School"
                >
            </div>
            <div class="kelz-home">
                <img 
                    class="kelz-2home" 
                    src="https://storage.googleapis.com/<%= bucketName %>/direct/m4.jpg" 
                    alt="Classroom activities at David Ofoeyeno Special School"
                >
            </div>
            <div class="kelz-home">
                <img 
                    class="kelz-2home" 
                    src="https://storage.googleapis.com/<%= bucketName %>/direct/A11.jpg" 
                    alt="Inclusive education at David Ofoeyeno Special School"
                >
            </div>
        </div>

        <div class="container">
            <% if (user && user.isAdmin) { %>
                <a href="/academics/new" class="btn">New Academics Post</a>
            <% } %>
        
            <div class="posts-grid">
                <% posts.forEach(post => { %>
                    <article class="card">
                        <!-- Clickable area (card content) -->
                        <a href="/academics/<%= post.slug %>" class="card-link">
                            <div class="card-body">
                                <h3 class="class-title"><%= post.title %></h3>
                                <div class="sub-title"><%= post.createdAt.toLocaleDateString() %></div>
                                
                                <% if (post.imagePath) { %>
                                    <div class="image-container">
                                        <img 
                                            src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" 
                                            alt="Academic program: <%= post.title %> at David Ofoeyeno Special School"
                                            class="article-image"
                                            onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                                        >
                                    </div>
                                <% } %>
                                
                                <div class="class-text">
                                    <%= post.description %>
                                </div>
                            </div>
                        </a>
        
                        <!-- Admin controls outside of the clickable area -->
                        <% if (user && user.isAdmin) { %>
                            <div class="btn-flex">
                                <a href="/academics/edit/<%= post.id %>" class="Edit">
                                    Edit
                                </a>
                                <form 
                                    action="/academics/<%= post.id %>?_method=DELETE" 
                                    method="POST"
                                    onsubmit="return confirm('Are you sure you want to delete this post?');"
                                >
                                    <button type="submit" class="btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </article>
                <% }) %>
            </div>

            <!-- Schema Markup for Articles -->
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ItemList",
                "itemListElement": [
                    <% posts.forEach((post, index) => { %>
                    {
                        "@type": "Article",
                        "position": <%= index + 1 %>,
                        "name": "<%= post.title %>",
                        "url": "https://davidofoeyenospecialschool.com/academics/<%= post.slug %>",
                        "image": "<%= post.imagePath ? 'https://storage.googleapis.com/' + bucketName + '/' + post.imagePath : '' %>",
                        "description": "<%= post.description %>",
                        "datePublished": "<%= post.createdAt.toISOString() %>",
                        "author": {
                            "@type": "Organization",
                            "name": "David Ofoeyeno Special School"
                        },
                        "publisher": {
                            "@type": "Organization",
                            "name": "David Ofoeyeno Special School",
                            "logo": {
                                "@type": "ImageObject",
                                "url": "https://storage.googleapis.com/<%= bucketName %>/direct/newlogo.jpg"
                            }
                        },
                        "address": {
                            "@type": "PostalAddress",
                            "streetAddress": "Comrade David Ofoeyeno School, Oputu Lay-out off Port-Harcourt Drive Dsc Township Orhuwhorun, Behind Challenge Academy",
                            "addressLocality": "Warri",
                            "addressRegion": "Delta State",
                            "postalCode": "320242",
                            "addressCountry": "Nigeria"
                        }
                    }<%= index < posts.length - 1 ? ',' : '' %>
                    <% }) %>
                ]
            }
            </script>
        </div>
        
        <%- include('../partials/footer.ejs') %>
        
        <script>
            function toggleMobileMenu(menu) {
                var isOpen = menu.classList.toggle('open');
                if (!isOpen) {
                    closeDropdowns();
                }
            }
            
            function toggleDropdown(event) {
                event.stopPropagation();
                var parentListItem = event.target.parentElement;
                parentListItem.classList.toggle('open');
            }
            
            function closeDropdowns() {
                var dropdowns = document.querySelectorAll('.has-dropdown');
                dropdowns.forEach(function(dropdown) {
                    dropdown.classList.remove('open');
                });
            }
            
            document.addEventListener('click', function(event) {
                var dropdowns = document.querySelectorAll('.has-dropdown');
                dropdowns.forEach(function(dropdown) {
                    if (!dropdown.contains(event.target)) {
                        dropdown.classList.remove('open');
                    }
                });
            });
            
            window.addEventListener('resize', function() {
                closeDropdowns();
            });
            
            document.getElementById('ham-icon').addEventListener('click', function(event) {
                if (!event.currentTarget.classList.contains('open')) {
                    closeDropdowns();
                }
            });
        
            document.addEventListener('DOMContentLoaded', function() {
                const slides = document.querySelectorAll('.carousel-slide');
                let currentSlide = 0;
        
                function showSlide(n) {
                    slides[currentSlide].classList.remove('active');
                    slides[currentSlide].classList.add('prev');
                    
                    currentSlide = (n + slides.length) % slides.length;
                    
                    slides[currentSlide].classList.remove('prev');
                    slides[currentSlide].classList.add('next');
                    
                    setTimeout(() => {
                        slides[currentSlide].classList.remove('next');
                        slides[currentSlide].classList.add('active');
                    }, 50);
                }
        
                function autoAdvance() {
                    showSlide(currentSlide + 1);
                }
        
                slides[currentSlide].classList.add('active');
                setInterval(autoAdvance, 3000);
            });

            document.addEventListener("DOMContentLoaded", function () {
                const items = document.querySelectorAll(".kelz-home");
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                        } else {
                            entry.target.classList.remove("visible");
                        }
                    });
                }, { threshold: 0.1 });
                items.forEach(item => observer.observe(item));
            });
        </script>
    </body>
</html>