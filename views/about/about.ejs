<!-- views/about/about.ejs -->
<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head.ejs', { 
      title: 'About David Ofoeyeno Special School', 
      description: 'Learn about David Ofoeyeno Special School in Warri, Delta State, a private school dedicated to supporting children with autism and neurological disorders.' 
  }) %>
  <body>
    <%- include('../partials/nav.ejs') %>

    <div class="updates-2nd">
      <h1>Welcome to David Ofoeyeno Special School</h1>
      <p>
        <a href="/">David Ofoeyeno Special School</a> is a private school in Warri, Delta State, for children living with autism and neurological disorders. Located in a serene environment with adequate security, our qualified staff, specialists, therapists, and skilled caregivers provide tailored support. Our learning environments and teaching approaches are adapted to meet the unique needs of our students, fostering their growth and development. Learn about our <a href="/academics">academic programs</a> and <a href="/activity">activities</a>.
      </p>
    </div>

    <div class="kelz-images">
      <div class="kelz-1">
          <img 
              class="kelz-2" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/b30.jpg" 
              alt="Students at David Ofoeyeno Special School"
          >
      </div>
      <div class="kelz-1">
          <img 
              class="kelz-2" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/b39.jpg" 
              alt="Learning environment at David Ofoeyeno Special School"
          >
      </div>
      <div class="kelz-1">
          <img 
              class="kelz-2" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/A10.jpg" 
              alt="Special needs support at David Ofoeyeno Special School"
          >
      </div>
      <div class="kelz-1">
          <img 
              class="kelz-2" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/st1.jpg" 
              alt="Therapeutic activities at David Ofoeyeno Special School"
          >
      </div>
    </div>

    <div class="container">
      <% if (user && user.isAdmin) { %>
        <a href="/about/new" class="btn">New About Post</a>
      <% } %>
  
      <div class="posts-grid">
        <% posts.forEach(post => { %>
          <article class="card">
            <!-- Clickable area (card content) -->
            <a href="/about/<%= post.slug %>" class="card-link">
              <div class="card-body">
                <h3 class="class-title"><%= post.title %></h3>
                <div class="sub-title"><%= post.createdAt.toLocaleDateString() %></div>
                
                <% if (post.imagePath) { %>
                  <div class="image-container">
                    <img 
                      src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" 
                      alt="About: <%= post.title %> at David Ofoeyeno Special School"
                      class="article-image"
                      onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                    >
                  </div>
                <% } %>
                
                <div class="class-text">
                  <%= post.description %>
                </div>
              </div>
            </a>
  
            <!-- Admin controls outside of the clickable area -->
            <% if (user && user.isAdmin) { %>
              <div class="btn-flex">
                <a href="/about/edit/<%= post.id %>" class="Edit">
                  Edit
                </a>
                <form 
                  action="/about/<%= post.id %>?_method=DELETE" 
                  method="POST"
                  onsubmit="return confirm('Are you sure you want to delete this post?');"
                >
                  <button type="submit" class="btn-danger">
                    Delete
                  </button>
                </form>
              </div>
            <% } %>
          </article>
        <% }) %>
      </div>

      <!-- Schema Markup for Articles -->
      <script type="application/ld+json">
      {
          "@context": "https://schema.org",
          "@type": "ItemList",
          "itemListElement": [
              <% posts.forEach((post, index) => { %>
              {
                  "@type": "Article",
                  "position": <%= index + 1 %>,
                  "name": "<%= post.title %>",
                  "url": "https://davidofoeyenospecialschool.com/about/<%= post.slug %>",
                  "image": "<%= post.imagePath ? 'https://storage.googleapis.com/' + bucketName + '/' + post.imagePath : '' %>",
                  "description": "<%= post.description %>",
                  "datePublished": "<%= post.createdAt.toISOString() %>",
                  "author": {
                      "@type": "Organization",
                      "name": "David Ofoeyeno Special School"
                  },
                  "publisher": {
                      "@type": "Organization",
                      "name": "David Ofoeyeno Special School",
                      "logo": {
                          "@type": "ImageObject",
                          "url": "https://storage.googleapis.com/<%= bucketName %>/direct/newlogo.jpg"
                      }
                  },
                  "address": {
                      "@type": "PostalAddress",
                      "streetAddress": "Comrade David Ofoeyeno School, Oputu Lay-out off Port-Harcourt Drive Dsc Township Orhuwhorun, Behind Challenge Academy",
                      "addressLocality": "Warri",
                      "addressRegion": "Delta State",
                      "postalCode": "320242",
                      "addressCountry": "Nigeria"
                  }
              }<%= index < posts.length - 1 ? ',' : '' %>
              <% }) %>
          ]
      }
      </script>
    </div>

    <div class="about-com">
      <h2>Our Community</h2>
      <p>
        At <a href="/">David Ofoeyeno Special School</a> in Warri, Delta State, we foster a sense of community and belonging for children with autism and neurological disorders. Our strong support network, including parents, caregivers, and the local community, creates a collaborative environment to support student growth. Join us in our mission to make a difference. Contact us or visit our school to experience our dedication. Explore our <a href="/academics">academics</a> and <a href="/autism">Autism Acceptance Day</a> events.
      </p>
    </div>

    <div class="kelz2-images">
      <div class="kelz-11">
          <img 
              class="kelz-22" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/m1.jpg" 
              alt="Community engagement at David Ofoeyeno Special School"
          >
      </div>
      <div class="kelz-11">
          <img 
              class="kelz-22" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/t3.jpg" 
              alt="Student activities at David Ofoeyeno Special School"
          >
      </div>
      <div class="kelz-11">
          <img 
              class="kelz-22" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/m5.jpg" 
              alt="Support programs at David Ofoeyeno Special School"
          >
      </div>
      <div class="kelz-11">
          <img 
              class="kelz-22" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/m4.jpg" 
              alt="Inclusive community at David Ofoeyeno Special School"
          >
      </div>
    </div>

    <%- include('../partials/footer.ejs') %>

    <script>
      function toggleMobileMenu(menu) {
        var isOpen = menu.classList.toggle('open');
        if (!isOpen) {
          closeDropdowns();
        }
      }
      
      function toggleDropdown(event) {
        event.stopPropagation();
        var parentListItem = event.target.parentElement;
        parentListItem.classList.toggle('open');
      }
      
      function closeDropdowns() {
        var dropdowns = document.querySelectorAll('.has-dropdown');
        dropdowns.forEach(function(dropdown) {
          dropdown.classList.remove('open');
        });
      }
      
      document.addEventListener('click', function(event) {
        var dropdowns = document.querySelectorAll('.has-dropdown');
        dropdowns.forEach(function(dropdown) {
          if (!dropdown.contains(event.target)) {
            dropdown.classList.remove('open');
          }
        });
      });
      
      window.addEventListener('resize', function() {
        closeDropdowns();
      });
      
      document.getElementById('ham-icon').addEventListener('click', function(event) {
        if (!event.currentTarget.classList.contains('open')) {
          closeDropdowns();
        }
      });

      document.addEventListener("DOMContentLoaded", function () {
        const items = document.querySelectorAll(".kelz-1");
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            } else {
              entry.target.classList.remove("visible");
            }
          });
        }, { threshold: 0.1 });
        items.forEach(item => observer.observe(item));
      });

      document.addEventListener('DOMContentLoaded', function () {
        const images = document.querySelectorAll('.kelz-22');
        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.1
        };
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('in-view');
            } else {
              entry.target.classList.remove('in-view');
            }
          });
        }, observerOptions);
        images.forEach(image => observer.observe(image));
      });
    </script>
  </body>
</html>