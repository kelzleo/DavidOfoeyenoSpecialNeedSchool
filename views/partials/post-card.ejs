<%
  // locals: post, cfg, user
  const date = post.createdAt.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
%>
<article class="card">
  <% if (post.imagePath) { %>
    <img class="card__img" src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" alt="" width="800" height="600" loading="lazy" decoding="async">
  <% } else { %>
    <img class="card__img" src="/img/placeholder.svg" alt="" width="800" height="600" loading="lazy">
  <% } %>
  <div class="card__body">
    <time class="card__date" datetime="<%= post.createdAt.toISOString() %>"><%= date %></time>
    <h3 class="card__title">
      <a class="card__link" href="<%= cfg.path %>/<%= post.slug %>"><%= post.title %></a>
    </h3>
    <% if (post.description) { %><p class="card__text"><%= post.description %></p><% } %>
    <span class="card__more" aria-hidden="true">Read more &rarr;</span>
  </div>
  <% if (locals.user && user.isAdmin) { %>
    <div class="card__admin">
      <a class="btn btn--ghost btn--sm" href="<%= cfg.path %>/edit/<%= post.id %>">Edit</a>
      <form action="<%= cfg.path %>/<%= post.id %>?_method=DELETE" method="POST" data-confirm="Are you sure you want to delete this post?">
        <button type="submit" class="btn btn--danger btn--sm">Delete</button>
      </form>
    </div>
  <% } %>
</article>
