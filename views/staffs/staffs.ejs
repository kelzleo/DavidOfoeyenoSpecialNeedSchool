<!-- views/staffs/staffs.ejs -->
<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head.ejs', { title: 'Staffs' }) %>

    <body>
        <%- include('../partials/nav.ejs') %>

        <div class="records-first">
            <h2>Meet Our Dedicated Staff</h2>
            <p>At the Comrade David Ofoeyeno School for Special Children with Neurological Disorders, our team of passionate and dedicated professionals is committed to providing exceptional care and support for our students. Each member of our staff brings unique skills, experiences, and compassion to our community, creating a nurturing environment where every child can thrive.</p>
            <h2>24 Hours Service</h2>
            <p>Our staff, both teaching and non-teaching, ensure the children are looked after and cared for 24 hours a day. They are also taught different tasks to enable the development of their skills and abilities.</p>
        </div>

        <div class="record-2nd">
            <div class="record-2ndpic">
                <img src="https://storage.googleapis.com/<%= bucketName %>/direct/st1.jpg" alt="ovo">
            </div>
            <div class="record-2ndpic">
                <img src="https://storage.googleapis.com/<%= bucketName %>/direct/b19.jpg" alt="drake spotify record">
            </div>
        </div>

        <section class="hero-rec">
          <img class="hero-img" src="https://storage.googleapis.com/<%= bucketName %>/direct/logo.jpg" alt="Drake fan website" />
          <h1 class="hero-heading">
            <span>Well</span>
            <span>Experienced</span>
            <span>And</span>
            <span>Dedicated</span>
          </h1>
          <div class="wave-container-rec">
            <svg viewBox="0 0 500 150" preserveAspectRatio="none">
              <path class="wave" d="M0.00,49.98 C150.00,150.00 349.98,-50.00 500.00,49.98 L500.00,150.00 L0.00,150.00 Z"></path>
            </svg>
          </div>
        </section>

        <div class="records-container">
          <% if (user && user.isAdmin) { %>
            <a href="/staffs/new" class="btn">New Staff Post</a>
          <% } %>
      
          <div class="records-posts-grid">
            <% posts.forEach(post => { %>
              <div class="records-card">
                <a href="/staffs/<%= post.slug %>" class="card-link">
                  <div class="records-card-body">
                    <h4 class="class-title"><%= post.title %></h4>
                    <div class="records-sub-title"><%= post.createdAt.toLocaleDateString() %></div>
                    
                    <% if (post.imagePath) { %>
                      <div class="image-container">
                        <img 
                          src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" 
                          alt="<%= post.title %>"
                          class="records-article-image"
                          onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                        >
                      </div>
                    <% } %>
                    
                    <div class="records-class-text">
                      <%= post.description %>
                    </div>
                  </div>
                </a>
      
                <% if (user && user.isAdmin) { %>
                  <div class="btn-flex">
                    <a href="/staffs/edit/<%= post.id %>" class="Edit">
                      Edit
                    </a>
                    <form 
                      action="/staffs/<%= post.id %>?_method=DELETE" 
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this post?');"
                    >
                      <button type="submit" class="btn-danger">
                        Delete
                      </button>
                    </form>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
        
        <%- include('../partials/footer.ejs') %>
        
        <script>
            function toggleMobileMenu(menu) {
              var isOpen = menu.classList.toggle('open');
              if (!isOpen) {
                  closeDropdowns();
              }
          }
          
          function toggleDropdown(event) {
              event.stopPropagation();
              var parentListItem = event.target.parentElement;
              parentListItem.classList.toggle('open');
          }
          
          function closeDropdowns() {
              var dropdowns = document.querySelectorAll('.has-dropdown');
              dropdowns.forEach(function(dropdown) {
                  dropdown.classList.remove('open');
              });
          }
          
          document.addEventListener('click', function(event) {
              var dropdowns = document.querySelectorAll('.has-dropdown');
              dropdowns.forEach(function(dropdown) {
                  if (!dropdown.contains(event.target)) {
                      dropdown.classList.remove('open');
                  }
              });
          });
          
          window.addEventListener('resize', function() {
              closeDropdowns();
          });
          
          document.getElementById('ham-icon').addEventListener('click', function(event) {
              if (!event.currentTarget.classList.contains('open')) {
                  closeDropdowns();
              }
          });
        </script>
    </body>
</html>