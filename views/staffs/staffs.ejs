<!-- views/staffs/staffs.ejs -->
<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head.ejs', { 
        title: 'Our Staff - David Ofoeyeno Special School', 
        description: 'Meet the dedicated staff at David Ofoeyeno Special School in Warri, Delta State, providing 24/7 care and education for children with autism and neurological disorders.' 
    }) %>

    <body>
        <%- include('../partials/nav.ejs') %>

        <div class="records-first">
            <h1>Meet Our Dedicated Staff</h1>
            <p>
                At <a href="/">David Ofoeyeno Special School</a> in Warri, Delta State, our team of passionate professionals is committed to providing exceptional care and education for children with autism and neurological disorders. Our qualified staff, including teachers, therapists, and caregivers, create a nurturing environment where every child can thrive. Learn more about our <a href="/academics">academic programs</a> and <a href="/activity">activities</a>.
            </p>
            <h2>24/7 Care and Support</h2>
            <p>
                Our teaching and non-teaching staff provide round-the-clock care, ensuring children develop essential skills and abilities through tailored tasks and support. Explore our <a href="/about">mission and community</a> to see how we make a difference.
            </p>
        </div>

        <div class="record-2nd">
            <div class="record-2ndpic">
                <img 
                    src="https://storage.googleapis.com/<%= bucketName %>/direct/st1.jpg" 
                    alt="Staff at David Ofoeyeno Special School"
                >
            </div>
            <div class="record-2ndpic">
                <img 
                    src="https://storage.googleapis.com/<%= bucketName %>/direct/b19.jpg" 
                    alt="Caregivers supporting students at David Ofoeyeno Special School"
                >
            </div>
        </div>

        <section class="hero-rec">
          <img 
              class="hero-img" 
              src="https://storage.googleapis.com/<%= bucketName %>/direct/newlogo.jpg" 
              alt="David Ofoeyeno Special School logo"
          />
          <h2 class="hero-heading">
            <span>Well</span>
            <span>Experienced</span>
            <span>And</span>
            <span>Dedicated</span>
          </h2>
          <div class="wave-container-rec">
            <svg viewBox="0 0 500 150" preserveAspectRatio="none">
              <path class="wave" d="M0.00,49.98 C150.00,150.00 349.98,-50.00 500.00,49.98 L500.00,150.00 L0.00,150.00 Z"></path>
            </svg>
          </div>
        </section>

        <div class="records-container">
          <% if (user && user.isAdmin) { %>
            <a href="/staffs/new" class="btn">New Staff Post</a>
          <% } %>
      
          <div class="records-posts-grid">
            <% posts.forEach(post => { %>
              <article class="records-card">
                <a href="/staffs/<%= post.slug %>" class="card-link">
                  <div class="records-card-body">
                    <h3 class="class-title"><%= post.title %></h3>
                    <div class="records-sub-title"><%= post.createdAt.toLocaleDateString() %></div>
                    
                    <% if (post.imagePath) { %>
                      <div class="image-container">
                        <img 
                          src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" 
                          alt="Staff profile: <%= post.title %> at David Ofoeyeno Special School"
                          class="records-article-image"
                          onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                        >
                      </div>
                    <% } %>
                    
                    <div class="records-class-text">
                      <%= post.description %>
                    </div>
                  </div>
                </a>
      
                <% if (user && user.isAdmin) { %>
                  <div class="btn-flex">
                    <a href="/staffs/edit/<%= post.id %>" class="Edit">
                      Edit
                    </a>
                    <form 
                      action="/staffs/<%= post.id %>?_method=DELETE" 
                      method="POST"
                      onsubmit="return confirm('Are you sure you want to delete this post?');"
                    >
                      <button type="submit" class="btn-danger">
                        Delete
                      </button>
                    </form>
                  </div>
                <% } %>
              </article>
            <% }) %>
          </div>

          <!-- Schema Markup for Articles -->
          <script type="application/ld+json">
          {
              "@context": "https://schema.org",
              "@type": "ItemList",
              "itemListElement": [
                  <% posts.forEach((post, index) => { %>
                  {
                      "@type": "Article",
                      "position": <%= index + 1 %>,
                      "name": "<%= post.title %>",
                      "url": "https://davidofoeyenospecialschool.com/staffs/<%= post.slug %>",
                      "image": "<%= post.imagePath ? 'https://storage.googleapis.com/' + bucketName + '/' + post.imagePath : '' %>",
                      "description": "<%= post.description %>",
                      "datePublished": "<%= post.createdAt.toISOString() %>",
                      "author": {
                          "@type": "Organization",
                          "name": "David Ofoeyeno Special School"
                      },
                      "publisher": {
                          "@type": "Organization",
                          "name": "David Ofoeyeno Special School",
                          "logo": {
                              "@type": "ImageObject",
                              "url": "https://storage.googleapis.com/<%= bucketName %>/direct/logo.jpg"
                          }
                      },
                      "address": {
                          "@type": "PostalAddress",
                          "streetAddress": "Comrade David Ofoeyeno School, Oputu Lay-out off Port-Harcourt Drive Dsc Township Orhuwhorun, Behind Challenge Academy",
                          "addressLocality": "Warri",
                          "addressRegion": "Delta State",
                          "postalCode": "320242",
                          "addressCountry": "Nigeria"
                      }
                  }<%= index < posts.length - 1 ? ',' : '' %>
                  <% }) %>
              ]
          }
          </script>
        </div>
        
        <%- include('../partials/footer.ejs') %>
        
        <script>
            function toggleMobileMenu(menu) {
              var isOpen = menu.classList.toggle('open');
              if (!isOpen) {
                  closeDropdowns();
              }
          }
          
          function toggleDropdown(event) {
              event.stopPropagation();
              var parentListItem = event.target.parentElement;
              parentListItem.classList.toggle('open');
          }
          
          function closeDropdowns() {
              var dropdowns = document.querySelectorAll('.has-dropdown');
              dropdowns.forEach(function(dropdown) {
                  dropdown.classList.remove('open');
              });
          }
          
          document.addEventListener('click', function(event) {
              var dropdowns = document.querySelectorAll('.has-dropdown');
              dropdowns.forEach(function(dropdown) {
                  if (!dropdown.contains(event.target)) {
                      dropdown.classList.remove('open');
                  }
              });
          });
          
          document.addEventListener('resize', function() {
              closeDropdowns();
          });
          
          document.getElementById('ham-icon').addEventListener('click', function(event) {
              if (!event.currentTarget.classList.contains('open')) {
                  closeDropdowns();
              }
          });
        </script>
    </body>
</html>