<%- include('../partials/top') %>

<%- include('../partials/page-hero', {
  heroTitle: cfg.title,
  heroIntro: cfg.intro,
  heroImage: cfg.heroImage,
  heroAlt: cfg.heroAlt
}) %>

<% if (cfg.gallery.length) { %>
  <section class="section">
    <div class="container">
      <%- include('../partials/gallery', { items: cfg.gallery }) %>
    </div>
  </section>
<% } %>

<section class="section<%= cfg.gallery.length ? ' section--alt' : '' %>">
  <div class="container">
    <div class="section__head">
      <h2><%= cfg.sectionTitle %></h2>
      <% if (locals.user && user.isAdmin) { %>
        <a href="<%= cfg.path %>/new" class="btn btn--primary"><%= cfg.newLabel %></a>
      <% } %>
    </div>

    <% if (posts.length) { %>
      <div class="card-grid">
        <% posts.forEach((post) => { %>
          <%- include('../partials/post-card', { post, cfg }) %>
        <% }) %>
      </div>
    <% } else { %>
      <p class="empty">Nothing has been posted here yet. Please check back soon.</p>
    <% } %>
  </div>
</section>

<% if (cfg.closing) { %>
  <section class="section">
    <div class="container">
      <div class="prose">
        <h2><%= cfg.closing.title %></h2>
        <p><%= cfg.closing.body %></p>
      </div>
    </div>
    <div class="container">
      <%- include('../partials/gallery', { items: cfg.closing.gallery }) %>
    </div>
  </section>
<% } %>

<%- include('../partials/bottom') %>
