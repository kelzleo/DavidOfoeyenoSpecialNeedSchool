<!-- views/autism/autism.ejs -->
<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head.ejs', { 
        title: 'Autism Acceptance Day - David Ofoeyeno Special School', 
        description: 'Join David Ofoeyeno Special School in celebrating Autism Acceptance Day to promote awareness and inclusion for children with autism spectrum disorder in Warri, Delta State.' 
    }) %>
    <body>
        <%- include('../partials/nav.ejs') %>

        <div class="aut-wrap">
            <div class="aut-first">
                <h1>Autism Acceptance Day</h1>
                <p>Welcome to David Ofoeyeno Special School’s Autism Acceptance Day celebration, dedicated to supporting children with autism spectrum disorder (ASD) in Warri, Delta State.</p>
            </div>
        </div>

        <div class="aut-2nd">
            <h2>Autism Awareness at Our School</h2>
            <p>
                At <a href="/">David Ofoeyeno Special School</a>, we celebrate Autism Acceptance Day to raise awareness, foster understanding, and promote inclusion for individuals with autism spectrum disorder (ASD). Our inclusive environment in Warri, Delta State, celebrates the unique strengths and talents of every student. Join us in advocating for autism education and support. Explore our <a href="/activity">activities</a> to see how we engage our students.
            </p>
        </div>

        <div class="container">
            <% if (user && user.isAdmin) { %>
              <a href="/autism/new" class="btn">New Autism Day Post</a>
            <% } %>
        
            <div class="posts-grid">
              <% posts.forEach(post => { %>
                <article class="card">
                  <!-- Clickable area (card content) -->
                  <a href="/autism/<%= post.slug %>" class="card-link">
                    <div class="card-body">
                      <h3 class="class-title"><%= post.title %></h3>
                      <div class="sub-title"><%= post.createdAt.toLocaleDateString() %></div>
                      
                      <% if (post.imagePath) { %>
                        <div class="image-container">
                          <img 
                            src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" 
                            alt="Autism event: <%= post.title %> at David Ofoeyeno Special School"
                            class="article-image"
                            onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                          >
                        </div>
                      <% } %>
                      
                      <div class="class-text">
                        <%= post.description %>
                      </div>
                    </div>
                  </a>
        
                  <!-- Admin controls outside of the clickable area -->
                  <% if (user && user.isAdmin) { %>
                    <div class="btn-flex">
                      <a href="/autism/edit/<%= post.id %>" class="Edit">
                        Edit
                      </a>
                      <form 
                        action="/autism/<%= post.id %>?_method=DELETE" 
                        method="POST"
                        onsubmit="return confirm('Are you sure you want to delete this post?');"
                      >
                        <button type="submit" class="btn-danger">
                          Delete
                        </button>
                      </form>
                    </div>
                  <% } %>
                </article>
              <% }) %>
            </div>

            <!-- Schema Markup for Articles -->
            <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "ItemList",
                "itemListElement": [
                    <% posts.forEach((post, index) => { %>
                    {
                        "@type": "Article",
                        "position": <%= index + 1 %>,
                        "name": "<%= post.title %>",
                        "url": "https://davidofoeyenospecialschool.com/autism/<%= post.slug %>",
                        "image": "<%= post.imagePath ? 'https://storage.googleapis.com/' + bucketName + '/' + post.imagePath : '' %>",
                        "description": "<%= post.description %>",
                        "datePublished": "<%= post.createdAt.toISOString() %>",
                        "author": {
                            "@type": "Organization",
                            "name": "David Ofoeyeno Special School"
                        },
                        "publisher": {
                            "@type": "Organization",
                            "name": "David Ofoeyeno Special School",
                            "logo": {
                                "@type": "ImageObject",
                                "url": "https://storage.googleapis.com/<%= bucketName %>/direct/newlogo.jpg"
                            }
                        }
                    }<%= index < posts.length - 1 ? ',' : '' %>
                    <% }) %>
                ]
            }
            </script>
        </div>
        
        <%- include('../partials/footer.ejs') %>
        
        <script>
          function toggleMobileMenu(menu) {
            var isOpen = menu.classList.toggle('open');
            if (!isOpen) {
              closeDropdowns();
            }
          }
          
          function toggleDropdown(event) {
            event.stopPropagation();
            var parentListItem = event.target.parentElement;
            parentListItem.classList.toggle('open');
          }
          
          function closeDropdowns() {
            var dropdowns = document.querySelectorAll('.has-dropdown');
            dropdowns.forEach(function(dropdown) {
              dropdown.classList.remove('open');
            });
          }
          
          document.addEventListener('click', function(event) {
            var dropdowns = document.querySelectorAll('.has-dropdown');
            dropdowns.forEach(function(dropdown) {
              if (!dropdown.contains(event.target)) {
                dropdown.classList.remove('open');
              }
            });
          });
          
          window.addEventListener('resize', function() {
            closeDropdowns();
          });
          
          document.getElementById('ham-icon').addEventListener('click', function(event) {
            if (!event.currentTarget.classList.contains('open')) {
              closeDropdowns();
            }
          });

          document.addEventListener("DOMContentLoaded", function () {
            const items = document.querySelectorAll(".kelz-1");
            const observer = new IntersectionObserver((entries) => {
              entries.forEach(entry => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("visible");
                } else {
                  entry.target.classList.remove("visible");
                }
              });
            }, { threshold: 0.1 });
            items.forEach(item => observer.observe(item));
          });
        </script>
    </body>
</html>