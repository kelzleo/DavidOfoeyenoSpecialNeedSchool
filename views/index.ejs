<%- include('partials/top') %>

<section class="home-hero">
  <div class="container home-hero__grid">
    <div class="home-hero__text">
      <p class="eyebrow">Warri, Delta State &bull; Autism &amp; neurological disorders</p>
      <h1>Welcome to Comrade David Ofoeyeno Special School</h1>
      <p class="lead">
        Where every child’s journey is met with compassion, dedication and a commitment to excellence. Nestled in the heart of Udu, Delta State, our school is a beacon of hope and opportunity for children with neurological disorders and their families.
      </p>
      <div class="home-hero__actions">
        <a href="#about" class="btn btn--accent">Learn more</a>
        <a href="#contact" class="btn btn--outline-light">Contact us</a>
      </div>
    </div>
    <div class="home-hero__media">
      <img src="/img/hero-home.jpg" alt="A teacher helping students at computers in class" width="1600" height="1069" fetchpriority="high" decoding="async">
    </div>
  </div>
</section>

<section class="mantra" aria-label="Our motto">
  <p>Disability is not Inability</p>
</section>

<section class="facts" aria-label="At a glance">
  <ul class="container facts__list">
    <li><strong>Private school</strong><span>in Warri, Delta State</span></li>
    <li><strong>Autism &amp; neurological</strong><span>disorders supported</span></li>
    <li><strong>Qualified staff</strong><span>teachers, therapists &amp; caregivers</span></li>
    <li><strong>24/7 care</strong><span>in a serene, secure setting</span></li>
  </ul>
</section>

<section class="section" id="about">
  <div class="container split">
    <div class="prose">
      <h2>About our school</h2>
      <p>
        Founded on the principles of inclusivity and empowerment, Comrade David Ofoeyeno Special School is more than just an educational institution &mdash; it’s a community dedicated to unlocking the full potential of every child, regardless of their challenges. Named in honour of Comrade David Ofoeyeno, a visionary leader and advocate for children with special needs, our school embodies his spirit of resilience, compassion and unwavering belief in the power of education to transform lives.
      </p>
      <p>
        Our mission is simple yet profound: to provide a nurturing and inclusive environment where each student can thrive academically, socially and emotionally. We foster a culture of acceptance, understanding and respect, where differences are celebrated and every child is valued for who they are.
      </p>
      <a href="/about" class="btn btn--primary">More about us</a>
    </div>
    <img class="split__img" src="/img/s9.jpg" alt="Students learning together" width="960" height="640" loading="lazy" decoding="async">
  </div>
</section>

<section class="section section--alt">
  <div class="container">
    <div class="section__head section__head--center">
      <h2>Our vision</h2>
    </div>
    <div class="prose prose--center">
      <p>
        We believe in a holistic approach to education that recognises the unique strengths, abilities and challenges of each student. Through individualised learning plans, evidence-based practices and a focus on meaningful outcomes, we empower students to reach their full potential and become active participants in their own learning journey.
      </p>
    </div>

    <div class="feature-grid">
      <a class="feature" href="/academics">
        <h3>Our programmes</h3>
        <p>Tailored programmes that unlock each student’s personal and educational capabilities.</p>
        <span class="feature__more">Explore our programmes &rarr;</span>
      </a>
      <a class="feature" href="/activity">
        <h3>Activities</h3>
        <p>Structured learning, therapy and recreation that build confidence and creativity.</p>
        <span class="feature__more">See our activities &rarr;</span>
      </a>
      <a class="feature" href="/autism">
        <h3>Autism Acceptance Day</h3>
        <p>Raising awareness and promoting inclusion for children with autism spectrum disorder.</p>
        <span class="feature__more">Read more &rarr;</span>
      </a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section__head section__head--center">
      <h2>Life at our school</h2>
    </div>
    <%- include('partials/gallery', { items: [
      { file: 'b23.jpg', alt: 'Autism event at David Ofoeyeno Special School' },
      { file: 's1.jpg', alt: 'Student activity at David Ofoeyeno Special School' },
      { file: 's3.jpg', alt: 'Special needs program at David Ofoeyeno Special School' },
      { file: 's4.jpg', alt: 'Students at David Ofoeyeno Special School' },
      { file: 't1.jpg', alt: 'Teacher and students at David Ofoeyeno Special School' },
      { file: 's2.jpg', alt: 'Classroom at David Ofoeyeno Special School' },
      { file: 'A11.jpg', alt: 'Learning at David Ofoeyeno Special School' },
      { file: 'st1.jpg', alt: 'Staff of David Ofoeyeno Special School' },
      { path: '1751138331711_b29.jpg', alt: 'Students enjoying a music lesson at David Ofoeyeno Special School' },
      { file: 'm4.jpg', alt: 'Students learning computer skills at David Ofoeyeno Special School' }
    ], columns: 5 }) %>
  </div>
</section>

<% sections.forEach((section, index) => { %>
  <% if (section.posts.length) { %>
    <section class="section<%= index % 2 === 0 ? ' section--alt' : '' %>">
      <div class="container">
        <div class="section__head">
          <h2><%= section.cfg.navLabel === 'Staff' ? 'Our staff' : section.cfg.navLabel %></h2>
          <a class="section__all" href="<%= section.cfg.path %>">View all &rarr;</a>
        </div>
        <div class="card-grid">
          <% section.posts.forEach((post) => { %>
            <%- include('partials/post-card', { post, cfg: section.cfg }) %>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>
<% }) %>

<section class="section">
  <div class="container split">
    <div class="prose">
      <h2>Visit us</h2>
      <p>
        We welcome parents and guardians to come and see our school. Call or email us to arrange a visit and talk with our team about how we can support your child.
      </p>
      <p>
        Comrade David Ofoeyeno School, Oputu Lay-out off Port-Harcourt Drive, Dsc Township Orhuwhorun, Behind Challenge Academy, Near Warri, Delta State, Nigeria
      </p>
      <a href="tel:+2348162144476" class="btn btn--primary">Call +234 816 214 4476</a>
    </div>
    <iframe
      class="map"
      title="Map showing the location of David Ofoeyeno Special School"
      src="https://www.google.com/maps?q=Comrade+David+Ofoeyeno+School+Orhuwhorun+Warri+Delta+State+Nigeria&amp;output=embed"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"></iframe>
  </div>
</section>

<%- include('partials/jsonld', { data: {
  '@context': 'https://schema.org',
  '@type': 'School',
  name: 'David Ofoeyeno Special School',
  url: siteUrl,
  logo: `${siteUrl}/img/newlogo.jpg`,
  description: 'A private school in Warri, Delta State, supporting children with autism and neurological disorders.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Warri',
    addressRegion: 'Delta State',
    addressCountry: 'Nigeria'
  }
} }) %>

<%- include('partials/bottom') %>
