    <!-- Activity Posts Section -->
    <div class="container">
      <section class="latest-posts">
        <a href="/activity" style="text-decoration: none;">
          <h1>Activities</h1>
        </a>
        <% if (activityPosts && activityPosts.length) { %>
          <div class="posts-grid">
            <% activityPosts.forEach(post => { %>
              <article class="card">
                <a href="/activity/<%= post.slug %>" class="card-link">
                  <div class="card-body">
                    <h4 class="class-title"><%= post.title %></h4>
                    <div class="sub-title"><%= post.createdAt.toLocaleDateString() %></div>
                    <% if (post.imagePath) { %>
                      <div class="image-container">
                        <img 
                            src="https://storage.googleapis.com/<%= bucketName %>/<%= post.imagePath %>" 
                            alt="Activity: <%= post.title %> at David Ofoeyeno Special School"
                            class="article-image"
                            onerror="this.onerror=null; this.src='/images/placeholder.jpg';"
                        >
                      </div>
                    <% } %>
                    <div class="class-text"><%= post.description %></div>
                  </div>
                </a>
                <% if (user && user.isAdmin) { %>
                  <div class="btn-flex">
                    <a href="/activity/edit/<%= post.id %>" class="Edit">Edit</a>
                    <form action="/activity/<%= post.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this post?');">
                      <button type="submit" class="btn-danger">Delete</button>
                    </form>
                  </div>
                <% } %>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p>No activity posts available yet.</p>
        <% } %>
      </section>
    </div>

